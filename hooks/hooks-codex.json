{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/java-hooks.mjs\" SessionStart --harness codex",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/java-hooks.mjs\" UserPromptSubmit --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/java-hooks.mjs\" PreToolUse --harness codex",
            "timeout": 10
          }
        ],
        "matcher": "apply_patch|Edit|Write|Bash|exec_command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/java-hooks.mjs\" PostToolUse --harness codex",
            "timeout": 10
          }
        ],
        "matcher": "apply_patch|Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/java-hooks.mjs\" Stop --harness codex",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
