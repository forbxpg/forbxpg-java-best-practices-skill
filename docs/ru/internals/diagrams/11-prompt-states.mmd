stateDiagram-v2
  state "Старт сессии" as Start
  state "Обычная работа" as Normal
  state "Контекст сжат" as Compacted

  [*] --> Start: SessionStart startup, resume, clear
  Start --> Normal: паспорт, в Claude и Codex ещё роутер
