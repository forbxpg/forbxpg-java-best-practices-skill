flowchart TB
  T["Текст .java и путь"] --> SC["stripCommentsAndStrings:<br/>комментарии и строки заменены пробелами,<br/>позиции и номера строк сохраняются"]
  SC --> LN["Построчный проход"]
  LN --> R1["Регулярки по строке:<br/>J1–J6, W2–W4, W6–W11"]
  LN --> R2["Блок аннотаций над объявлением:<br/>W1 сущность с @Data, W12 DTO с @Data"]
  SC --> R3["Пустые catch: W5"]
  P["Паспорт: версия Boot, MapStruct"] --> R1
  PATH["src/main или src/test"] --> R1
  R1 --> V["Нарушения: id, строка, текст строки"]
  R2 --> V
  R3 --> V
  V --> NV["newViolations до и после:<br/>мультимножество пар id + текст строки"]
  NV --> PRE["PreToolUse: новые жёсткие → блок"]
  NV --> POST["PostToolUse: новые мягкие → замечания"]
