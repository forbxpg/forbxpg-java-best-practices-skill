flowchart TB
  S["Stop: модель заканчивает ход"] --> A{"context_usage ≥ contextWarnAt<br/>и предупреждения ещё не было?<br/>context_usage присылает только GigaCode"}
  A -->|"да"| HB["block: запиши handoff,<br/>потом заканчивай"]
  A -->|"нет"| C{"stopCompile включён?"}
  C -->|"нет"| E0["exit 0: ход завершён"]
  C -->|"да"| D{"Сессия меняла .java?"}
  D -->|"нет"| E0
  D -->|"да"| FP{"Отпечаток файлов совпадает<br/>с последней успешной сборкой?"}
  FP -->|"да"| E0
  FP -->|"нет"| M["Модули изменённых файлов<br/>mvnw или mvn -q -o -pl a,b -am compile<br/>таймаут 180 с"]
  M --> T{"Таймаут?"}
  T -->|"да"| SM1["systemMessage:<br/>сборку проверить не удалось"]
  T -->|"нет"| OKQ{"Код 0?"}
  OKQ -->|"да"| SAVE["Запомнить отпечаток,<br/>обнулить счётчик блоков"] --> E0
  OKQ -->|"нет"| OWN{"Ошибки в файлах,<br/>которые меняла сессия?"}
  OWN -->|"нет"| SM2["systemMessage пользователю:<br/>офлайн-кэш, нет Maven,<br/>или сломаны чужие файлы"]
  OWN -->|"да"| CNT{"Уже 2 блока<br/>с последней успешной сборки?"}
  CNT -->|"да"| SM3["systemMessage:<br/>останавливаюсь без проверки"]
  CNT -->|"нет"| BL["block: до 10 ошибок<br/>файл:строка сообщение"]
