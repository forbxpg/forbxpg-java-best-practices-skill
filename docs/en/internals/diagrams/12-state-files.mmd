flowchart LR
  T["os.tmpdir()/forbxpg-java/"] --> P["12 characters of sha1 of the project root/"]
  P --> PP["passport.json<br/>passport cache by mtime and size of pom.xml"]
  P --> S["session_id/"]
  S --> s1["compacted.json<br/>compaction happened, waiting for a message"]
  S --> s2["contextWarned.json<br/>handoff already requested"]
  S --> s3["lastOkFingerprint.json<br/>fingerprint of the last successful build"]
  S --> s4["blocksSinceOk.json<br/>how many times Stop has blocked"]
  S --> s5["pre-call ID-path hash.json<br/>violations before the write, lives until PostToolUse"]
  S --> s6["changed/*.txt<br/>changed .java files, one file per path"]
  S --> s7["roles/*.txt<br/>roles whose rules were already shown"]
  S --> s9["violated/*.json<br/>broken rules with a timestamp, for the anchor"]
  S --> s10["roleSeen/*.json<br/>roles in order of first write, for the anchor"]
  S --> s8["hook.log<br/>internal hook errors"]
